# ─────────────────────────────────────────────────────────────────────────────
# RGE Hub — environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in real values. NEVER commit `.env`.
# In production (Vercel) set these via Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ─── OnyxBase backend (permanent app data: profiles, resources, follows) ────
ONYXBASE_BASE_URL=https://onyxbase-chi.vercel.app
ONYXBASE_API_KEY=kv_live_replace_with_your_master_key
# Named MCPEmail credential stored in OnyxBase — used by the OTP email
# FALLBACK path when MCPEMAILS_API_KEY is not set below.
ONYXBASE_EMAIL_CREDENTIAL=Email_Verification

# ─── MCPEmails direct delivery (preferred OTP email path, PRD §2) ───────────
# Create at mcpemails.com → Dashboard → API Keys (needs send:email scope).
# When set, OTP emails go straight from the RGE Hub backend to MCPEmails —
# OnyxBase is fully out of the OTP path. Server-side ONLY, never in the browser.
MCPEMAILS_API_KEY=
# Optional: the inbox UUID MCPEmails should send from (single-inbox keys
# auto-resolve — leave empty if your key has one inbox).
MCPEMAILS_INBOX_ID=

# ─── AI SENSE temporary OTP storage (PRD §4) ────────────────────────────────
# Unauthenticated temporary object store. Used ONLY for hashed, 10-minute
# OTP state. No key required; override the base URL only for testing.
AISENSE_STORAGE_URL=https://aisenseapi.com/services/v1/storage

# ─── Sessions / admin ────────────────────────────────────────────────────────
# openssl rand -hex 32 — signs session cookies and password-reset tokens.
SESSION_SECRET=
ADMIN_EMAIL=railguyedits@gmail.com
ADMIN_USER_IDS=

# ─── Public site URL (canonical resource links) ─────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rge-hub.vercel.app
